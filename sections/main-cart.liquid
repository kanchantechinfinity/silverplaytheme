<div class="sp-container sp-container--narrow cart-page" style="padding-top:160px;padding-bottom:120px;">
  <div class="section-head reveal" style="margin-bottom:40px;">
    <p class="eyebrow">Silver Play</p>
    <h1>Your Bag</h1>
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-drawer__empty" style="padding:40px 0;text-align:center;">
      <p>Your bag is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--ink">Continue Shopping</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
      <div class="cart-page__lines" data-cart-page-lines>
        {% for item in cart.items %}
          <div class="cart-line" data-cart-line data-key="{{ item.key }}">
            <a class="cart-line__image" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="125">
              {%- endif -%}
            </a>
            <div class="cart-line__body">
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == "Default Title" -%}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="cart-line__row">
                <div class="qty-stepper" data-cart-qty-stepper data-key="{{ item.key }}">
                  <button type="button" data-cart-line-decrease aria-label="Decrease quantity">&minus;</button>
                  <span data-cart-line-qty>{{ item.quantity }}</span>
                  <button type="button" data-cart-line-increase aria-label="Increase quantity">&plus;</button>
                </div>
                <span class="cart-line__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="cart-line__remove" data-cart-line-remove data-key="{{ item.key }}">Remove</button>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-page__summary">
        <div class="cart-drawer__subtotal">
          <span>Subtotal</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p style="font-family:var(--font-body);font-size:0.85rem;color:var(--sp-ash-3);margin-top:6px;">Shipping and taxes calculated at checkout.</p>
        <button type="submit" name="checkout" class="btn btn--ink" style="width:100%;justify-content:center;margin-top:20px;">Checkout</button>
      </div>
    </form>
  {% endif %}
</div>

{% schema %} { "name": "Cart", "settings": [] } {% endschema %}
