<section class="page-hero" data-page-hero>
  <div class="page-hero__bg">
    <img src="{{ section.blocks.first.settings.image | image_url: width: 1600 | default: section.settings.hero_image_fallback }}" alt="{{ section.settings.heading }}" loading="eager">
  </div>
  <div class="page-hero__content">
    <p class="eyebrow" style="color:var(--sp-ash-3);">{{ section.settings.eyebrow }}</p>
    <h1 class="reveal">{{ section.settings.heading }}</h1>
    <p class="desc reveal">{{ section.settings.description }}</p>
  </div>
</section>

<section class="split-row split-row--bone" style="padding-top:64px;">
  <div class="sp-container">
    <div class="stone-explorer" data-stone-explorer>
      <div class="stone-explorer__grid">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="stone-explorer__thumb{% if forloop.first %} is-active{% endif %}"
            data-stone-thumb
            data-stone-target="stone-{{ forloop.index0 }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ 'stone-placeholder' | placeholder_svg_tag }}" alt="{{ block.settings.name | escape }}">
            {%- endif -%}
            <span class="wash"><p>{{ block.settings.name }}</p></span>
          </button>
        {%- endfor -%}
      </div>

      <div class="stone-explorer__detail">
        {%- for block in section.blocks -%}
          <div class="stone-card" data-stone-panel id="stone-{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
            <div class="stone-card__inner">
              <div class="stone-card__photo">
                {%- if block.settings.image -%}
                  <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- else -%}
                  <img src="{{ 'stone-placeholder' | placeholder_svg_tag }}" alt="{{ block.settings.name | escape }}">
                {%- endif -%}
              </div>
              <div class="stone-card__body">
                <h3>{{ block.settings.name }}</h3>
                <p class="tagline">{{ block.settings.tagline }}</p>
                <p class="meaning">{{ block.settings.meaning }}</p>
                <ul class="stone-card__props">
                  {%- for line in block.settings.properties | newline_to_br | split: '<br />' -%}
                    {%- assign trimmed = line | strip -%}
                    {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
                <dl class="stone-card__facts">
                  <div class="row"><dt>Wear</dt><dd>{{ block.settings.how_to_wear }}</dd></div>
                  <div class="row"><dt>Care</dt><dd>{{ block.settings.care }}</dd></div>
                  <div class="row"><dt>Best For</dt><dd>{{ block.settings.when_to_wear }}</dd></div>
                </dl>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

