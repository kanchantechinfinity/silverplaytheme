<section class="carousel-dark" data-carousel>
  <div class="section-head reveal">
    <p class="eyebrow">The Edit</p>
    <h2 class="text-bone">{{ section.settings.heading | default: "Her Royal Simplicity" }}</h2>
    <p>{{ section.settings.copy | default: "For the woman who loves jewellery that feels effortless, personal and quietly beautiful." }}</p>
  </div>

  <div class="carousel-track-wrap">
    <div class="carousel-track" data-carousel-track>
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll != blank -%}
        {%- for product in coll.products limit: section.settings.count -%}
          <a href="{{ product.url }}" class="carousel-card">
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="520">
            <div class="carousel-card__wash"></div>
            <div class="carousel-card__chip"><span>{{ product.price | money }}</span></div>
            <div class="carousel-card__label"><p>{{ product.title }}</p></div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="carousel-controls">
    <button type="button" class="carousel-arrow" data-carousel-prev aria-label="Previous piece">&larr;</button>
    <button type="button" class="carousel-arrow carousel-arrow--solid" data-carousel-next aria-label="Next piece">&rarr;</button>
    <a href="{{ coll.url | default: '/collections/all' }}" class="carousel-link">Shop The Edit &rarr;</a>
  </div>
</section>

{% schema %}
{
  "name": "Her Royal Simplicity",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Her Royal Simplicity" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "For the woman who loves jewellery that feels effortless, personal and quietly beautiful." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "presets": [{ "name": "Her Royal Simplicity" }]
}
{% endschema %}
