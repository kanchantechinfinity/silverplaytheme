<section class="split-row split-row--bone">
  <div class="sp-container">
    <div class="split-row__grid">
      <div class="split-row__text reveal">
        <h2>{{ section.settings.heading | default: "Wear Your Story" }}</h2>
        <p>{{ section.settings.paragraph | default: "Silver Play promises jewellery that is elegant, expressive and thoughtfully made. We create 925 silver pieces that feel premium, meaningful and easy to wear — jewellery that adds beauty to everyday moments, grace to celebrations and emotion to gifting. Because silver is not just something you wear. It is something you feel." }}</p>
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn--ink split-row__cta">
          {{ section.settings.cta_label | default: "Explore The Collection" }}
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="split-row__media reveal">
        <img src="{{ section.settings.image | default: 'https://silverplay.in/cdn/shop/files/10_bd25934c-b7a1-4db5-adaf-80994f406f55_800x1200_crop_center.png?v=1781618694' }}" alt="{{ section.settings.heading }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About closing row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear Your Story" },
    { "type": "textarea", "id": "paragraph", "label": "Paragraph" },
    { "type": "url", "id": "image", "label": "Image" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore The Collection" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "About closing row" }]
}
{% endschema %}
