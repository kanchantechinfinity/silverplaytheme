<section class="heritage-sec" style="background:var(--sp-bone-3); padding:96px 0;" data-tabs>
  <img class="heritage-bg" src="{{ 'fresh-edit-courtyard.jpg' | asset_url }}" alt="" loading="lazy">
  <div class="heritage-wash" style="background:rgba(219,197,150,0.72);"></div>

  <div class="sp-container">
    <div class="section-head reveal">
      <p class="eyebrow">Just Landed</p>
      <h2>{{ section.settings.heading | default: "The Fresh Edit" }}</h2>
      <p>{{ section.settings.copy | default: "The newest additions to the Silver Play line — fresh cuts, fresh stones, straight from the workshop." }}</p>
    </div>

    <div class="tab-row reveal">
      <div class="tab-pills">
        <button type="button" class="tab-pill is-active" data-tab-btn="new">New Arrivals</button>
        <button type="button" class="tab-pill" data-tab-btn="earrings">Earrings</button>
        <button type="button" class="tab-pill" data-tab-btn="pendants">Pendants</button>
      </div>
    </div>

    {%- assign new_coll = collections[section.settings.new_collection] -%}
    {%- assign earrings_coll = collections[section.settings.earrings_collection] -%}
    {%- assign pendants_coll = collections[section.settings.pendants_collection] -%}

    <div class="tab-panel is-active" data-tab-panel="new">
      <div class="product-grid">
        {%- if new_coll != blank -%}
          {%- for product in new_coll.products limit: section.settings.count -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <div class="tab-panel" data-tab-panel="earrings">
      <div class="product-grid">
        {%- if earrings_coll != blank -%}
          {%- for product in earrings_coll.products limit: section.settings.count -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <div class="tab-panel" data-tab-panel="pendants">
      <div class="product-grid">
        {%- if pendants_coll != blank -%}
          {%- for product in pendants_coll.products limit: section.settings.count -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="tab-row reveal" style="margin-top:56px;">
      <a href="{{ new_coll.url | default: '/collections/all' }}" class="btn btn--ink">Shop New Arrivals <span class="btn__arrow">&rarr;</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fresh Edit (Gen-Z)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Fresh Edit" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "The newest additions to the Silver Play line — fresh cuts, fresh stones, straight from the workshop." },
    { "type": "collection", "id": "new_collection", "label": "New Arrivals collection" },
    { "type": "collection", "id": "earrings_collection", "label": "Earrings collection" },
    { "type": "collection", "id": "pendants_collection", "label": "Pendants collection" },
    { "type": "range", "id": "count", "label": "Products per tab", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Fresh Edit (Gen-Z)" }]
}
{% endschema %}
