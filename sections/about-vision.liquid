<section class="split-row split-row--ink">
  <div class="sp-container">
    <div class="section-head reveal">
      <p class="eyebrow">{{ section.settings.eyebrow | default: "Our Vision" }}</p>
      <h2 style="color:var(--sp-bone);">{{ section.settings.heading | default: "What We Choose, Every Time" }}</h2>
    </div>
    <div class="vision-grid">
      {%- for block in section.blocks -%}
        <div class="gold-card reveal">
          <div class="gold-card__inner">
            <span class="gold-card__glyph" aria-hidden="true">{{ block.settings.glyph }}</span>
            <h3 class="gold-card__title">{{ block.settings.title }}</h3>
            <p class="gold-card__body">{{ block.settings.body }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About vision cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Vision" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What We Choose, Every Time" }
  ],
  "blocks": [
    { "type": "vision", "name": "Vision card", "settings": [
      { "type": "text", "id": "glyph", "label": "Glyph", "default": "◈" },
      { "type": "text", "id": "title", "label": "Title", "default": "Slow Making" },
      { "type": "textarea", "id": "body", "label": "Body" }
    ] }
  ],
  "default": {
    "blocks": [
      { "type": "vision", "settings": { "glyph": "◈", "title": "Slow Making", "body": "We believe in slow making over mass production. Every piece takes the time real craft requires, shaped by hand rather than rushed off a line." } },
      { "type": "vision", "settings": { "glyph": "✿", "title": "Natural Over Synthetic", "body": "We work with natural, lightly finished stones wherever possible — the earth's imperfections are part of the beauty, not a flaw to be hidden." } },
      { "type": "vision", "settings": { "glyph": "❧", "title": "Stories Over Trends", "body": "We take pride in being transparent about what goes into each piece: the metal grade, the stone type, the craft involved, the story it carries." } }
    ]
  },
  "presets": [{ "name": "About vision cards" }]
}
{% endschema %}
