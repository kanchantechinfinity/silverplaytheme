<div class="hero-pin" data-hero-pin>
  <section class="hero" data-page-hero>
    <video
      class="hero__video"
      data-hero-video
      autoplay muted loop playsinline preload="metadata"
      poster="{{ section.settings.poster_url | default: 'https://silverplay.in/cdn/shop/articles/ChatGPT_Image_Jun_24_2026_11_11_09_AM.png' }}"
    >
      <source src="{{ 'silverplay-cinematic.mp4' | asset_url }}" type="video/mp4">
    </video>
    <div class="hero__wash-v"></div>
    <div class="hero__wash-h"></div>

    <div class="hero__content" data-hero-content>
      <p class="hero__title">{{ section.settings.title | default: "Timeless Silver." }}</p>
      <p class="hero__sub">{{ section.settings.subtitle | default: "Crafted as Heritage." }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/earrings' }}" class="btn btn--bone hero__cta">
          {{ section.settings.cta_label }}
          <span class="btn__arrow">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="hero__scroll-cue" data-hero-cue>
      <span class="label">Scroll to discover</span>
      <span class="line"></span>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Cinematic Hero",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Timeless Silver." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Crafted as Heritage." },
    { "type": "url", "id": "poster_url", "label": "Poster image URL (fallback)" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore Collection" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Cinematic Hero" }]
}
{% endschema %}
