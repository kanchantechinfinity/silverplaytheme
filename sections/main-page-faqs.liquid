<section class="page-hero" data-page-hero>
  <div class="page-hero__bg">
    <img src="{{ section.settings.hero_image | default: 'https://silverplay.in/cdn/shop/files/5_800x1200_crop_center.png?v=1780901024' }}" alt="{{ section.settings.heading }}" loading="eager">
  </div>
  <div class="page-hero__content">
    <p class="eyebrow" style="color:var(--sp-ash-3);">{{ section.settings.eyebrow | default: "Good To Know" }}</p>
    <h1 class="reveal">{{ section.settings.heading | default: "Frequently Asked Questions" }}</h1>
    <p class="desc reveal">{{ section.settings.description | default: "Everything you need to know about ordering, shipping, returns and caring for your Silver Play pieces." }}</p>
  </div>
</section>

<section class="faq-section">
  <div class="sp-container">
    <div class="faq-list" style="margin-top:0;border-top:1px solid rgba(242,232,208,0.12);">
      {%- for block in section.blocks -%}
        <div class="faq-row" {{ block.shopify_attributes }}>
          <div class="faq-row__top">
            <span class="faq-row__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="faq-row__body">
              <h3 class="faq-row__q">{{ block.settings.question }}</h3>
              <p class="faq-row__a">{{ block.settings.answer }}</p>
            </div>
            <span class="faq-row__icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 14 14 6"/><path d="M7.5 6H14v6.5"/></svg>
            </span>
          </div>
          {%- if block.settings.image_url != blank -%}
            <div class="faq-row__thumb">
              <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="112" height="160">
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQs page",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good To Know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "url", "id": "hero_image", "label": "Banner image" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" },
        { "type": "url", "id": "image_url", "label": "Accent image (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "FAQs page" }]
}
{% endschema %}
