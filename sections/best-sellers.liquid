<section class="heritage-sec" style="background:var(--sp-ink-3); padding:96px 0;">
  <img class="heritage-bg" src="{{ 'seen-ghat-vista.jpg' | asset_url }}" alt="" loading="lazy">
  <div class="heritage-wash" style="background:rgba(58,43,28,0.62);"></div>

  <div class="sp-container">
    <div class="section-head reveal">
      <p class="eyebrow">As Seen &amp; Loved</p>
      <h2 class="text-bone">{{ section.settings.heading | default: "Best Sellers" }}</h2>
      <p style="color:rgba(242,232,208,0.6);">{{ section.settings.copy | default: "The pieces Silver Play wearers keep coming back for — proven favourites, worn on repeat." }}</p>
    </div>

    <div class="product-grid">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll != blank -%}
        {%- for product in coll.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="tab-row reveal" style="margin-top:56px;">
      <a href="{{ coll.url | default: '/collections/all' }}" class="btn btn--bone">Shop Best Sellers <span class="btn__arrow">&rarr;</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "The pieces Silver Play wearers keep coming back for — proven favourites, worn on repeat." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Best Sellers" }]
}
{% endschema %}
