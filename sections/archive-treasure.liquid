<section class="heritage-sec archive-section">
  <img class="heritage-bg" src="{{ 'archive-balcony.jpg' | asset_url }}" alt="" loading="lazy">
  <div class="heritage-wash" style="background:rgba(242,232,208,0.75);"></div>

  <div class="sp-container archive-layout">
    <div class="archive-text reveal">
      <p class="eyebrow">Heritage</p>
      <h2>The Archive Silver Treasure</h2>
      <a href="/collections/virasat" class="btn btn--ink btn--sm">Shop The Collection <span class="btn__arrow">&rarr;</span></a>
    </div>

    <div class="archive-collage">
      {%- for block in section.blocks -%}
        {%- assign tilt = forloop.index0 | modulo: 3 -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign title = block.settings.title | default: coll.title -%}
        {%- assign collection_url = coll.url | default: block.settings.collection_url -%}
        {%- assign back_image = coll.products.first.featured_image | image_url: width: 320 -%}
        {%- if block.settings.back_image != blank -%}{%- assign back_image = block.settings.back_image -%}{%- endif -%}
        <div class="archive-tilt-{{ tilt }} reveal">
          <div class="flip-card">
            <div class="flip-card__inner">
              <div class="flip-card__face">
                <img src="{{ block.settings.front_image }}" alt="{{ title }}" loading="lazy" width="320" height="400">
                <div class="flip-card__wash"></div>
                <div class="flip-card__label">
                  <p class="deva">{{ block.settings.deva }}</p>
                  <p class="name">{{ title }}</p>
                </div>
              </div>
              <div class="flip-card__face flip-card__face--back">
                <img src="{{ back_image }}" alt="{{ title }}" loading="lazy" width="320" height="400">
                <div class="flip-card__wash flip-card__wash--deep"></div>
                <div class="flip-card__label">
                  <p class="name">{{ title }}</p>
                  <a href="{{ collection_url }}" class="flip-card__cta">Shop The Collection &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Archive Silver Treasure",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "text", "id": "deva", "label": "Hindi name" },
        { "type": "text", "id": "title", "label": "Title (overrides collection title)" },
        { "type": "collection", "id": "collection", "label": "Collection (drives link + fallback back image)" },
        { "type": "url", "id": "collection_url", "label": "Collection link (used if no collection picked)" },
        { "type": "url", "id": "front_image", "label": "Front (archival) image" },
        { "type": "url", "id": "back_image", "label": "Back image (overrides collection's first product image)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "collection", "settings": { "deva": "विरासत", "title": "Heritage", "collection_url": "/collections/virasat", "front_image": "https://silverplay.in/cdn/shop/files/Rajsi_SP_Website_41ccae1d-7e58-4695-b942-459bc0411093_800x1200_crop_center.png?v=1781610360", "back_image": "https://cdn.shopify.com/s/files/1/0702/4456/5101/files/sterling-silver-paan-leaf-drop-earrings.png?v=1786310303" } },
      { "type": "collection", "settings": { "deva": "कारीगरी", "title": "Craftsmanship", "collection_url": "/collections/karigari-1", "front_image": "https://silverplay.in/cdn/shop/files/8_66ed8200-edb7-48db-85c0-60bc06df74ca_800x1200_crop_center.png?v=1781618694", "back_image": "https://cdn.shopify.com/s/files/1/0702/4456/5101/files/sterling-silver-conch-shell-filigree-earrings.png?v=1786310431" } },
      { "type": "collection", "settings": { "deva": "रत्न विरासत", "title": "Gemstone Heritage", "collection_url": "/collections/ratna-virasat-1", "front_image": "https://silverplay.in/cdn/shop/files/5_800x1200_crop_center.png?v=1780901024", "back_image": "https://cdn.shopify.com/s/files/1/0702/4456/5101/files/sterling-silver-prairie-rose-office-earring.png?v=1786310324" } },
      { "type": "collection", "settings": { "deva": "नज़ाकत", "title": "Elegance", "collection_url": "/collections/nazakat-1", "front_image": "https://silverplay.in/cdn/shop/files/10_bd25934c-b7a1-4db5-adaf-80994f406f55_800x1200_crop_center.png?v=1781618694", "back_image": "https://cdn.shopify.com/s/files/1/0702/4456/5101/files/sterling-silver-teardrop-fan-stud-earrings.png?v=1786310365" } },
      { "type": "collection", "settings": { "deva": "शाही", "title": "Regal", "collection_url": "/collections/raajsi-shahi", "front_image": "https://silverplay.in/cdn/shop/files/SP_Website_Banners_10_800x1200_crop_center.png?v=1783577220", "back_image": "https://cdn.shopify.com/s/files/1/0702/4456/5101/files/sterling-silver-ornate-chandbali-drop-earrings.png?v=1786310348" } },
