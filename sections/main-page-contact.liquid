<section class="page-hero" data-page-hero>
  <div class="page-hero__bg">
    <img src="{{ section.settings.hero_image | default: 'https://silverplay.in/cdn/shop/files/5_800x1200_crop_center.png?v=1780901024' }}" alt="{{ section.settings.heading }}" loading="eager">
  </div>
  <div class="page-hero__content">
    <p class="eyebrow" style="color:var(--sp-ash-3);">{{ section.settings.eyebrow | default: "Get in Touch" }}</p>
    <h1 class="reveal">{{ section.settings.heading | default: "We'd Love to Hear from You" }}</h1>
    <p class="desc reveal">{{ section.settings.description | default: "Silver Play Studio — handcrafted 925 silver jewellery from the heart of Jaipur. We respond to all queries within 24 hours." }}</p>
  </div>
</section>

<div class="contact-layout">
  <div class="contact-info reveal">
    <div class="contact-info__row">
      <span class="contact-info__glyph" aria-hidden="true">&#9993;</span>
      <div>
        <p class="contact-info__label">Email Us</p>
        <div class="contact-info__value">
          <a href="mailto:{{ section.settings.email | default: 'care@silverplay.in' }}">{{ section.settings.email | default: 'care@silverplay.in' }}</a>
        </div>
      </div>
    </div>

    <div class="contact-info__row">
      <span class="contact-info__glyph" aria-hidden="true">&#9711;</span>
      <div>
        <p class="contact-info__label">Hours</p>
        <p class="contact-info__value">{{ section.settings.hours | default: "Mon–Sat: 10am – 7pm IST" }}</p>
      </div>
    </div>

    <div class="contact-info__row">
      <span class="contact-info__glyph" aria-hidden="true">&#10022;</span>
      <div>
        <p class="contact-info__label">Follow Along</p>
        <div class="contact-info__social">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' -%}
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer">{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="contact-form-card reveal">
    <div class="contact-form-card__inner">
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <p class="contact-form__success">Thank you — your message has been sent. We'll get back to you within 24 hours.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="contact-form__error">
            {%- for field in form.errors -%}
              <p>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="contact-form">
          <div class="contact-form__row">
            <div>
              <label for="ContactFormName">Name *</label>
              <input type="text" id="ContactFormName" name="contact[name]" required value="{% if form.name %}{{ form.name }}{% endif %}">
            </div>
            <div>
              <label for="ContactFormEmail">Email *</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" required value="{% if form.email %}{{ form.email }}{% endif %}">
            </div>
          </div>

          <div>
            <label for="ContactFormSubject">Subject</label>
            <input type="text" id="ContactFormSubject" name="contact[subject]">
          </div>

          <div>
            <label for="ContactFormMessage">Message *</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="btn btn--ink">
            Send Message
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd Love to Hear from You" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "url", "id": "hero_image", "label": "Banner image" },
    { "type": "header", "content": "Contact info" },
    { "type": "text", "id": "email", "label": "Email", "default": "care@silverplay.in" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sat: 10am – 7pm IST" }
  ],
  "blocks": [
    { "type": "social", "name": "Social link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "default": {
    "blocks": [
      { "type": "social", "settings": { "label": "Instagram", "url": "https://www.instagram.com/thesilverplay/" } },
      { "type": "social", "settings": { "label": "Facebook", "url": "https://facebook.com/thesilverplay" } }
    ]
  }
}
{% endschema %}
