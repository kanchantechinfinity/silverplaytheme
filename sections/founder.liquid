<section class="founder-section">
  <div class="sp-container">
    <div class="founder-grid">
      <div class="founder-photo reveal">
        <img src="{{ section.settings.image_url | default: 'https://silverplay.in/cdn/shop/files/Dalljiet_Kaur_in_Silver.jpg?v=1781853368' }}" alt="{{ section.settings.name | default: 'Dalljiet Kaur' }}" loading="lazy" width="640" height="800">
      </div>
      <div class="founder-copy">
        <p class="eyebrow reveal">{{ section.settings.eyebrow | default: "The Founder" }}</p>
        <h2 class="reveal">{{ section.settings.heading | default: "A Timeless Curation by" }}</h2>
        <p class="bio reveal">{{ section.settings.bio | default: "Dalljiet Kaur believes jewellery should make people feel seen, valued and connected. Her vision for Silver Play is to create a brand where silver feels luxurious, meaningful and relevant for modern life. A brand where people can find jewellery for themselves, for someone special and for moments that deserve to be remembered. Through Silver Play, she wants to bring back the charm of thoughtful jewellery in a modern way. Pieces that feel personal. Pieces that carry beauty. Pieces that become part of everyday life and lasting memories." }}</p>
        <div class="founder-name reveal">
          <p class="name">{{ section.settings.name | default: "Dalljiet Kaur" }}</p>
          <p class="title">{{ section.settings.title | default: "Founder, Silver Play" }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder",
  "settings": [
    { "type": "url", "id": "image_url", "label": "Portrait image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Founder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Timeless Curation by" },
    { "type": "textarea", "id": "bio", "label": "Bio" },
    { "type": "text", "id": "name", "label": "Name", "default": "Dalljiet Kaur" },
    { "type": "text", "id": "title", "label": "Title", "default": "Founder, Silver Play" }
  ],
  "presets": [{ "name": "Founder" }]
}
{% endschema %}
