<section class="insta-section">
  <div class="sp-container">
    <div class="insta-head">
      <div>
        <p class="eyebrow reveal">As Seen &amp; Loved</p>
        <h2 class="reveal">@thesilverplay</h2>
      </div>
      <a href="https://www.instagram.com/thesilverplay/" target="_blank" rel="noopener noreferrer" class="insta-follow reveal">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.3"/><circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"/></svg>
        Follow on Instagram
      </a>
    </div>

    <div class="insta-track-wrap" data-drag-scroll>
      <div class="insta-track">
        {%- for block in section.blocks -%}
          <a href="https://www.instagram.com/thesilverplay/" target="_blank" rel="noopener noreferrer" class="insta-item">
            <div class="insta-item__photo">
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" loading="lazy" width="256" height="256">
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

