<div class="assurance-bar">
  <div class="marquee">
    <div class="marquee__track" style="animation-duration: 48s;">
      {%- for i in (1..2) -%}
        <div class="marquee__set">
          {%- for block in section.blocks -%}
            <span class="marquee__item">{{ block.settings.text }}<span class="marquee__sep">—</span></span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Assurance Bar",
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "BIS Certified" } },
      { "type": "item", "settings": { "text": "925 Sterling Silver" } },
      { "type": "item", "settings": { "text": "Purity Guaranteed" } },
      { "type": "item", "settings": { "text": "Artisan Crafted in India" } },
      { "type": "item", "settings": { "text": "Savings With Every Purchase" } },
      { "type": "item", "settings": { "text": "The Silver Play Exchange Policy" } },
      { "type": "item", "settings": { "text": "Free Shipping on Prepaid Orders" } },
      { "type": "item", "settings": { "text": "Skin-Friendly" } }
    ]
  },
  "presets": [{ "name": "Assurance Bar" }]
}
{% endschema %}
